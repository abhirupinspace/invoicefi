# ==========================================================================
# InvoiceFi environment configuration
# Copy this file to .env and fill in real values.
# ==========================================================================

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (Postgres). When using docker compose the host is "postgres".
DATABASE_URL=postgresql://invoicefi:invoicefi@localhost:5432/invoicefi?schema=public

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
ADMIN_SECRET=change_me_admin_bootstrap_secret

# Redis (optional). Leave empty to fall back to in memory rate limiting.
REDIS_URL=

# OpenAI (invoice analysis, pricing narrative, AI chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mistral OCR (invoice extraction)
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_CONFIDENCE_THRESHOLD=0.6

# Stellar / Soroban
STELLAR_NETWORK=testnet
SOROBAN_RPC=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Platform signing account (secret key, starts with S...). Required for real
# on chain calls. When empty the blockchain service runs in dry run mode.
STELLAR_PLATFORM_SECRET=

# Deployed contract ids (filled after running the deploy script)
INVOICE_NFT_CONTRACT=
MARKETPLACE_CONTRACT=
SETTLEMENT_CONTRACT=

# Payment token used by marketplace and settlement. When empty the deploy
# script wraps the native XLM asset into a Stellar Asset Contract.
PAY_TOKEN_CONTRACT=

# Storage
STORAGE_DRIVER=local
STORAGE_DIR=storage
